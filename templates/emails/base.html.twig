<!doctype html>
<html lang="fr">
<body style="margin:0;padding:0;background:#F4F6F8;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F4F6F8;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="max-width:480px;width:100%;">
          <tr>
            <td style="padding:4px 8px 20px;text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:800;color:#6D28D9;letter-spacing:.2px;">
              À la bonne station
            </td>
          </tr>
          <tr>
            <td style="background:#FFFFFF;border:1px solid #E6E9EF;border-radius:16px;padding:32px 28px;">
              <h1 style="margin:0 0 12px;font-family:Arial,Helvetica,sans-serif;font-size:22px;font-weight:800;color:#14161C;">
                {% block heading %}{% endblock %}
              </h1>
              <p style="margin:0 0 24px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:23px;color:#4A5160;">
                {% block intro %}{% endblock %}
              </p>
              {% block body %}{% endblock %}
            </td>
          </tr>
          <tr>
            <td style="padding:20px 12px;text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#8A93A2;">
              {% block footnote %}{% endblock %}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
