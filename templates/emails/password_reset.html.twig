{% extends 'emails/base.html.twig' %}

{% block heading %}{{ 'Réinitialisation du mot de passe'|t }}{% endblock %}

{% block intro %}{{ 'Voici ton code de vérification. Saisis-le dans l\'application pour choisir un nouveau mot de passe.'|t }}{% endblock %}

{% block body %}
  <div style="text-align:center;background:#F4F6F8;border:1px solid #E6E9EF;border-radius:12px;padding:18px 12px;">
    <span style="font-family:'Courier New',Courier,monospace;font-size:34px;font-weight:800;letter-spacing:10px;color:#6D28D9;">{{ code }}</span>
  </div>
{% endblock %}

{% block footnote %}{{ 'Ce code expire dans 15 minutes. Si tu n\'es pas à l\'origine de cette demande, ignore cet email.'|t }}{% endblock %}
